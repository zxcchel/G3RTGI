#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly  image2D rawGI;
layout(set = 0, binding = 1, rgba16f) uniform readonly  image2D histRead;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D histWrite;
layout(set = 0, binding = 3, rgba8)   uniform writeonly image2D outImage;

layout(push_constant) uniform DenoisePush {
    mat4 invViewProj;
    mat4 prevViewProj;
} pc;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(outImage);
    if (pix.x >= dim.x || pix.y >= dim.y) return;

    vec4 center = imageLoad(rawGI, pix);
    float hitT  = center.a;
    if (hitT <= 0.0) {
        imageStore(histWrite, pix, vec4(0.0));
        imageStore(outImage,  pix, vec4(0.5, 0.5, 0.5, 1.0));
        return;
    }

    // 1. Пространственный Bilateral-блюр 5x5 с защитой краёв по глубине
    vec3  sumCol = vec3(0.0);
    float sumW   = 0.0;
    vec3  minCol = vec3(1e9);
    vec3  maxCol = vec3(-1e9);

    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            ivec2 p = clamp(pix + ivec2(dx, dy), ivec2(0), dim - 1);
            vec4 s = imageLoad(rawGI, p);
            if (s.a <= 0.0) continue;

            float relDepth = abs(s.a - hitT) / max(hitT, 10.0);
            float wDepth   = exp(-relDepth * 25.0);
            float wSpatial = exp(-float(dx * dx + dy * dy) * 0.25);
            float w = wDepth * wSpatial;

            sumCol += s.rgb * w;
            sumW   += w;

            if (abs(dx) <= 1 && abs(dy) <= 1) {
                minCol = min(minCol, s.rgb);
                maxCol = max(maxCol, s.rgb);
            }
        }
    }

    vec3 spatialGI = (sumW > 1e-5) ? (sumCol / sumW) : center.rgb;
    minCol = min(minCol, spatialGI * 0.85);
    maxCol = max(maxCol, spatialGI * 1.15);

    // 2. Темпоральная репроекция в предыдущий кадр
    vec2 uv  = (vec2(pix) + 0.5) / vec2(dim);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 pNear = vec4(ndc, 0.0, 1.0) * pc.invViewProj;
    vec4 pFar  = vec4(ndc, 1.0, 1.0) * pc.invViewProj;
    vec3 wNear = pNear.xyz / pNear.w;
    vec3 wFar  = pFar.xyz  / pFar.w;
    vec3 hitPos = wNear + normalize(wFar - wNear) * hitT;

    vec4 prevClip = vec4(hitPos, 1.0) * pc.prevViewProj;
    vec3 finalGI  = spatialGI;

    if (prevClip.w > 0.001) {
        vec2 prevNdc = prevClip.xy / prevClip.w;
        vec2 prevUv  = vec2(prevNdc.x * 0.5 + 0.5, 0.5 - prevNdc.y * 0.5);
        if (prevUv.x >= 0.0 && prevUv.x < 1.0 && prevUv.y >= 0.0 && prevUv.y < 1.0) {
            ivec2 prevPix = clamp(ivec2(prevUv * vec2(dim)), ivec2(0), dim - 1);
            vec4 hist = imageLoad(histRead, prevPix);
            if (hist.a > 0.0) {
                // Clamping по локальной окрестности убирает шлейфы при движении
                vec3 clampedHist = clamp(hist.rgb, minCol, maxCol);
                finalGI = mix(clampedHist, spatialGI, 0.15);
            }
        }
    }

    imageStore(histWrite, pix, vec4(finalGI, hitT));
    vec3 mapped = finalGI / (1.0 + finalGI * 0.5);
    vec3 srgb = pow(max(finalGI, vec3(0.0)), vec3(1.0 / 2.2)) * 0.5;
    imageStore(outImage, pix, vec4(clamp(srgb, 0.0, 1.0), 1.0));
}